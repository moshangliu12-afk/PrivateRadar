{
  "name": "private-radar",
  "version": "0.2.0-alpha.20",
  "productName": "PrivateRadar",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moshangliu12-afk/PrivateRadar"
  },
  "homepage": "https://github.com/moshangliu12-afk/PrivateRadar#readme",
  "bugs": {
    "url": "https://github.com/moshangliu12-afk/PrivateRadar/issues"
  },
  "author": "PrivateRadar",
  "description": "本地优先的个人聊天情报系统",
  "engines": {
    "node": ">=24"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:mcp",
    "build:mcp": "node scripts/prepare-third-party-licenses.cjs && esbuild ./src/main/integrations/workbuddy/server.ts --bundle --platform=node --format=esm --outfile=./integrations/workbuddy/connector/dist/server.mjs --metafile=./integrations/workbuddy/connector/dist/license-inputs.json && node scripts/prepare-third-party-licenses.cjs --check",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist:mac:arm64": "node scripts/package-macos-arm64.mjs",
    "dist:mac:arm64:signed": "node scripts/package-macos-arm64-signed.mjs",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "cn.privateradar.desktop",
    "productName": "PrivateRadar",
    "asar": true,
    "beforePack": "./scripts/prepare-third-party-licenses.cjs",
    "afterPack": "./scripts/prepare-third-party-licenses.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/zod/src/v3/tests{,/**/*}",
      "!node_modules/zod/src/v4/{classic,core,mini}/tests{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "integrations/workbuddy/connector",
        "to": "workbuddy-connector",
        "filter": [
          "connector-meta.json",
          "mcp.json",
          "icon.svg",
          "skills/**/*",
          "dist/server.mjs",
          "licenses/**/*"
        ]
      },
      {
        "from": "licenses/runtime",
        "to": "licenses",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "PrivateRadar-Setup-${version}-x64.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "dir", "arch": ["arm64"] }
      ],
      "identity": null,
      "forceCodeSigning": false,
      "notarize": false,
      "artifactName": "PrivateRadar-${version}-macOS-arm64-unsigned.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PrivateRadar",
      "uninstallDisplayName": "PrivateRadar",
      "deleteAppDataOnUninstall": false
    }
  }
}
