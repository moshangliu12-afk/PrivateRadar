# 可选：开发时覆盖本地数据库目录。不要把真实路径和密钥提交到版本库。
# PRIVATE_RADAR_DATA_DIR=C:\Users\你的用户名\AppData\Roaming\PrivateRadar
# 可选：开发时注入内置七天 Demo；默认首次启动为空数据库。
# PRIVATE_RADAR_SEED_DEMO=true

# 不配置以下变量时，应用自动使用规则模式。
# 本地开发可设置 PRIVATE_RADAR_AI_PROVIDER=mock 验证完整 D2 链路；它不会访问网络。
# PRIVATE_RADAR_AI_PROVIDER=mock

# OpenAI Compatible 服务配置。密钥只从本机环境读取，不会写入数据库或日志。
# PRIVATE_RADAR_AI_BASE_URL=http://127.0.0.1:11434/v1
# PRIVATE_RADAR_AI_MODEL=
# PRIVATE_RADAR_AI_API_KEY=

# 可选语义检索。不配置时自动使用“全文搜索”模式。
# 本地开发可使用 mock，不访问网络。
# PRIVATE_RADAR_EMBEDDING_PROVIDER=mock
# PRIVATE_RADAR_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# PRIVATE_RADAR_EMBEDDING_MODEL=
# PRIVATE_RADAR_EMBEDDING_DIMENSIONS=1536
# PRIVATE_RADAR_EMBEDDING_API_KEY=
